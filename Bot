local function setRunning(state)
	if state and not Bot.Target then
		setStatus("сначала выберите игрока")
		TweenService:Create(toggle, TweenInfo.new(0.1), { Position = UDim2.new(0, 18, 1, -78) }):Play()
		task.delay(0.1, function()
			TweenService:Create(toggle, TweenInfo.new(0.1), { Position = UDim2.new(0, 12, 1, -78) }):Play()
		end)
		return
	end

	Bot.Running = state
	Bot.Token += 1
	Bot.Stuck = false
	Bot.Sword = nil
	Bot.Visited = {}
	Bot.Steps = 0
	Bot.LastDir = nil
	Bot.NextPathTime = 0

	if state then
		toggle.Text = "■  Бежать до цели: ВКЛ"
		Twee
