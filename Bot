local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.RespectCanCollide = true

local function getParts(plr)
	local char = plr and plr.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if hum and hrp and hum.Health > 0 then
		return char, hum, hrp
	end
end

local function active(token)
	return Bot.Running and Bot.Token == token
end

local function groundAt(pos, up, len)
	return workspace:Raycast(pos + Vector3.new(0, up, 0), Vector3.new(0, -len, 0), rayParams)
end

local function floorY(pos)
	local hit = groundAt(pos, 1, 10)
	return hit and hit.Position.Y or pos.Y - 3
end

local function hasLineOfSight(from, to)
	return workspace:Raycast(from, to - from, rayParams) == nil
end

local function groundOk(from, to)
	local flat = (to - from) * Vector3.new(1, 0, 1)
	local dist = flat.Magnitude
	if dist < 1 then return true end
	local dir = flat.Unit
	local prevY = floorY(from)
	for d = 2, dist, 2 do
		local hit = groundAt(from + dir * d, 4, 20)
		if not hit then return false end
		local y = hit.Position.Y
		if prevY - y > 6 or y - prevY > 3.5 then return false end
		prevY = y
	end
	return true
end

local function dirClear(pos, dir, fy)
	local low = workspace:Raycast(pos - Vector3.new(0, 2, 0), dir * 4, rayParams)
	local high = workspace:Raycast(pos + Vector3.new(0, 1.5, 0), dir * 4, rayParams)
	if low and high then return false end
	for _, d in ipairs({ 3, 6 }) do
		local hit = groundAt(pos + dir * d, 3, 16)
		if not hit then return false end
		if fy - hit.Position.Y > 7 then return false end
	end
	return true
end

local function cellKey(p)
	return math.floor(p.X / 5) .. "," .. math.floor(p.Y / 8) .. "," .. math.floor(p.Z / 5)
end

local function steerStep(myHum, myHrp, tHrp)
	local pos = myHrp.Position
	local fy = floorY(pos)
	local toT = (tHrp.Position - pos) * Vector3.new(1, 0, 1)
	local toDir = toT.Magnitude > 0.1 and toT.Unit or Vector3.zAxis

	Bot.Steps += 1
	if Bot.Steps > 60 then
		Bot.Visited = {}
		Bot.Steps = 0
	end

	if Bot.Stuck then
		Bot.Stuck = false
		if Bot.LastDir then
			local k = cellKey(pos + Bot.LastDir * 6)
			Bot.Visited[k] = (Bot.Visited[k] or 0) + 3
		end
	end

	local bestDir, bestScore = nil, -math.huge
	for i = 0, 15 do
		local a = i / 16 * math.pi * 2
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		if dirClear(pos, dir, fy) then
			local score = dir:Dot(toDir) * 2
			score -= (Bot.Visited[cellKey(pos + dir * 6)] or 0) * 0.7
			if Bot.LastDir then
				score += dir:Dot(Bot.LastDir) * 0.6
			end
			if score > bestScore then
				bestScore, bestDir = score, dir
			end
		end
	end

	local key = cellKey(pos)
	Bot.Visited[key] = (Bot.Visited[key] or 0) + 1

	if bestDir then
		Bot.LastDir = bestDir
		myHum:MoveTo(pos + bestDir * 8)
	else
		Bot.LastDir = nil
		myHum.Jump = true
		myHum:MoveTo(pos - toDir * 6)
	end
	task.wait(0.35)
end

local function snapGoal(tHrp)
	local hit = groundAt(tHrp.Position, 0, 40)
	if hit then
		return hit.Position
	end
	return tHrp.Position
end

local function findPath(myHrp, tHrp, token)
	local base = snapGoal(tHrp)
	local goals = { base }
	for _, o in ipairs({
		Vector3.new(4, 0, 0),
		Vector3.new(-4, 0, 0),
		Vector3.new(0, 0, 4),
		Vector3.new(0, 0, -4),
	}) do
		local hit = groundAt(base + o, 6, 30)
		if hit then
			table.insert(goals, hit.Position)
		end
	end

	for _, agent in ipairs(AGENTS) do
		for _, goal in ipairs(goals) do
			if not active(token) then return end
			local path = PathfindingService:CreatePath({
				AgentRadius = agent.AgentRadius,
				AgentHeight = agent.AgentHeight,
				AgentCanJump = true,
				AgentCanClimb = true,
				WaypointSpacing = CONFIG.WaypointSpacing,
				Costs = { Water = 20 },
			})
			local ok = pcall(function()
				path:ComputeAsync(myHrp.Position, goal)
			end)
			if ok and path.Status == Enum.PathStatus.Success then
				return path
			end
		end
	end
end

local function getSword()
	local char = LocalPlayer.Character
	if not char then return end
	local equipped = char:FindFirstChildOfClass("Tool")
	if equipped then return equipped end
	local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
	if backpack then
		for _, t in ipairs(backpack:GetChildren()) do
			if t:IsA("Tool") then
				return t
			end
		end
	end
end

local function faceTarget(myHrp, tHrp)
	local look = Vector3.new(tHrp.Position.X, myHrp.Position.Y, tHrp.Position.Z)
	if (look - myHrp.Position).Magnitude > 0.1 then
		myHrp.CFrame = CFrame.lookAt(myHrp.Position, look)
	end
end

local function attackLoop(token)
	while active(token) do
		local _, myHum, myHrp = getParts(LocalPlayer)
		local _, _, tHrp = getParts(Bot.Target)

		if CONFIG.AutoAttack and myHum and tHrp
			and (tHrp.Position - myHrp.Position).Magnitude <= CONFIG.AttackRange then

			local sword = Bot.Sword
			local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
			if not sword or not sword.Parent
				or (sword.Parent ~= LocalPlayer.Character and sword.Parent ~= backpack) then
				sword = getSword()
				Bot.Sword = sword
			end

			if sword then
				if sword.Parent ~= LocalPlayer.Character then
					myHum:EquipTool(sword)
					task.wait(0.1)
				end
				faceTarget(myHrp, tHrp)
				pcall(function()
					sword:Activate()
				end)
			end
			task.wait(CONFIG.AttackCooldown)
		else
			task.wait(0.1)
		end
	end
end

local lastPos, lastCheck = nil, 0
RunService.Heartbeat:Connect(function()
	if not Bot.Running then
		lastPos = nil
		return
	end
	local _, hum, hrp = getParts(LocalPlayer)
	if not hum then return end

	local now = os.clock()
	local dir = hum.MoveDirection

	if Bot.Moving and dir.Magnitude > 0.1 and hum.FloorMaterial ~= Enum.Material.Air then
		local flatDir = Vector3.new(dir.X, 0, dir.Z).Unit

		local low = workspace:Raycast(hrp.Position - Vector3.new(0, 2, 0), flatDir * 3.5, rayParams)
		local high = workspace:Raycast(hrp.Position + Vector3.new(0, 1.5, 0), flatDir * 3.5, rayParams)
		if low and high then
			if low.Distance < 2.5 and high.Distance < 2.5 and now - Bot.WallTime > 0.6 then
				Bot.WallTime = now
				Bot.Stuck = true
			end
		elseif low and not high then
			hum.Jump = true
		end

		local fy = floorY(hrp.Position)
		local near = groundAt(hrp.Position + flatDir * 3, 3, 14)
		local far = groundAt(hrp.Position + flatDir * 8, 3, 14)
		local nearVoid = (not near) or (fy - near.Position.Y > 10)
		if nearVoid then
			if (not far) or (fy - far.Position.Y > 10) then
				hum:MoveTo(hrp.Position)
				Bot.Stuck = true
			else
				hum.Jump = true
			end
		end
	end

	if Bot.Moving then
		if not lastPos then
			lastPos, lastCheck = hrp.Position, now
		elseif now - lastCheck >= CONFIG.StuckTime then
			if (hrp.Position - lastPos).Magnitude < CONFIG.StuckDistance then
				Bot.Stuck = true
				hum.Jump = true
			end
			lastPos, lastCheck = hrp.Position, now
		end
	else
		lastPos = nil
	end
end)

local function follow(path, myHum, myHrp, goalRef, token)
	local waypoints = path:GetWaypoints()
	local blocked = false
	local conn = path.Blocked:Connect(function()
		blocked = true
	end)
	local started = os.clock()
	local abort = false
	local i = 2

	while i <= #waypoints and not abort do
		if not active(token) or os.clock() - started > CONFIG.MaxFollowTime then
			break
		end
		local wp = waypoints[i]
		if wp.Action == Enum.PathWaypointAction.Jump then
			myHum.Jump = true
		end
		myHum:MoveTo(wp.Position)

		local t0 = os.clock()
		while os.clock() - t0 < CONFIG.WaypointTimeout do
			task.wait(0.05)
			if not active(token) or not myHrp.Parent then
				abort = true
				break
			end

			local _, _, tHrp = getParts(Bot.Target)
			if not tHrp or (tHrp.Position - goalRef).Magnitude > CONFIG.TargetMoveThreshold then
				abort = true
				break
			end

			if blocked or Bot.Stuck then
				Bot.Stuck = false
				abort = true
				break
			end

			local flat = (wp.Position - myHrp.Position) * Vector3.new(1, 0, 1)
			if flat.Magnitude < 2.5 and math.abs(wp.Position.Y - myHrp.Position.Y) < 4 then
				break
			end
		end
		i += 1
	end

	conn:Disconnect()
end

local function runBot(token)
	while active(token) do
		local myChar, myHum, myHrp = getParts(LocalPlayer)
		local tChar, _, tHrp = getParts(Bot.Target)

		if not (myHum and tHrp) then
			Bot.Moving = false
			setStatus("Ожидание персонажа...")
			task.wait(0.5)
			continue
		end

		rayParams.FilterDescendantsInstances = { myChar, tChar }

		local dist = (tHrp.Position - myHrp.Position).Magnitude
		if dist <= CONFIG.StopDistance then
			Bot.Moving = false
			myHum:MoveTo(myHrp.Position)
			faceTarget(myHrp, tHrp)
			setStatus("Вплотную к цели ✓")
			task.wait(0.05)
			continue
		end

		Bot.Moving = true
		local heightDiff = math.abs(tHrp.Position.Y - myHrp.Position.Y)

		if heightDiff < 3.5
			and hasLineOfSight(myHrp.Position, tHrp.Position)
			and groundOk(myHrp.Position, tHrp.Position)
		then
			setStatus("Бегу напрямую...")
			myHum:MoveTo(tHrp.Position)
			task.wait(0.05)
			if Bot.Stuck then
				Bot.Stuck = false
				local side = myHrp.CFrame.RightVector * (math.random() < 0.5 and 6 or -6)
				myHum:MoveTo(myHrp.Position + side)
				task.wait(0.4)
			end
		else
			if os.clock() >= Bot.NextPathTime then
				setStatus("Ищу путь...")
				local path = findPath(myHrp, tHrp, token)
				if path then
					Bot.Visited = {}
					Bot.LastDir = nil
					setStatus("Иду по маршруту")
					follow(path, myHum, myHrp, tHrp.Position, token)
				else
					Bot.NextPathTime = os.clock() + CONFIG.RepathCooldown
				end
			else
				setStatus("Ищу проход...")
				steerStep(myHum, myHrp, tHrp)
			end
		end
	end

	Bot.Moving = false
	local _, hum, hrp = getParts(LocalPlayer)
	if hum and hrp then
		hum:MoveTo(hrp.Position)
	end
end

