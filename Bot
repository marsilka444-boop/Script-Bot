	Bot.Visited = {}
	Bot.LastDir = nil
	Bot.NextPathTime = 0
	targetLabel.Text = "Цель: " .. plr.DisplayName .. " (@" .. plr.Name .. ")"
	targetLabel.TextColor3 = COLORS.text
	for _, row in ipairs(list:GetChildren()) do
		if row:IsA("Frame") then
			local selected = row.Name == plr.Name
			TweenService:Create(row, TweenInfo.new(0.2), {
				BackgroundColor3 = selected and COLORS.rowSelected or COLORS.row,
			}):Play()
		end
	end
end

